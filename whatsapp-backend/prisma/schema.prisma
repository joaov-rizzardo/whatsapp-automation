generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  members     Member[]
  invitations Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

/// One WhatsApp connection per organization (spec 003). Our own table — no FK to
/// the Better Auth `organization` table; organizationId only ever arrives via
/// request.organizationId. Updated by the routes (user actions) and by the
/// evolution-events consumer (Evolution events resolved by instanceName).
model WhatsappConnection {
  id             String   @id @default(cuid())
  organizationId String   @unique
  instanceName   String   @unique
  status         String   @default("connecting") // connecting | open | close
  method         String   @default("qrcode") // qrcode | pairing — last method requested
  qrCode         String?  @db.Text // QR data URI (qrcode method); Text — a base64 PNG overflows varchar
  pairingCode    String? // 8-char code (pairing method)
  phoneNumber    String? // number given for pairing and/or the connected number
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("whatsapp_connection")
}

/// Uma automação da organização (spec 006). Sem FK para `organization` — mesma
/// regra da whatsapp_connection: `organizationId` só chega por
/// request.organizationId, nunca do payload.
model Automation {
  id             String @id @default(cuid())
  organizationId String
  name           String

  /// Só significa algo com uma versão publicada; o status tri-estado (rascunho
  /// | ativa | pausada) é derivado na service — nunca publicada = rascunho.
  isActive Boolean @default(false)

  /// Derivados do RASCUNHO a cada salvamento, para a lista não precisar
  /// carregar documento nenhum. A fonte da verdade continua sendo o nó de
  /// início do documento.
  trigger    Json @default("{\"kind\":\"none\"}")
  blockCount Int  @default(1)

  /// Ponteiros da publicação. Colunas soltas, sem relação Prisma, de propósito:
  /// uma FK automation -> flow_version fecharia um ciclo com o cascade da
  /// relação inversa. O repository faz o join à mão, numa consulta só.
  publishedVersionNumber Int?
  /// Versão do rascunho de onde a publicação saiu — é o que responde "há
  /// alterações não publicadas?" sem comparar documentos nem relógios.
  publishedDraftVersion  Int?
  publishedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draft    FlowDraft?
  versions FlowVersion[]

  @@index([organizationId])
  @@map("automation")
}

/// O que o editor edita. Um por automação, criado junto com ela — nenhuma
/// automação existe sem rascunho, então `GET .../flow` nunca trata "não tem".
model FlowDraft {
  id           String     @id @default(cuid())
  automationId String     @unique
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  /// O documento inteiro (§4.1 da spec): nodes, edges, variables, viewport.
  /// Opaco para o banco, validado pelo registry de blocos na escrita.
  document Json
  /// Trava otimista: sobe 1 a cada salvamento aceito. Versão que não bate → 409.
  version  Int  @default(1)

  updatedAt DateTime @updatedAt

  @@map("flow_draft")
}

/// Uma publicação. Imutável — nunca sofre UPDATE, só INSERT e o DELETE do
/// cascade. É o que o motor lê, e é o que deixa uma conversa em andamento
/// continuar na versão em que começou.
model FlowVersion {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  number       Int
  document     Json
  /// Copiado do nó de início no ato da publicação: o motor casa a mensagem
  /// recebida contra ISTO, nunca contra o gatilho do rascunho.
  trigger      Json
  /// De qual versão do rascunho esta publicação saiu.
  draftVersion Int

  publishedAt DateTime @default(now())

  @@unique([automationId, number])
  @@map("flow_version")
}

/// Quem já escreveu para o número da organização. NENHUMA coluna de conteúdo —
/// não é tabela de mensagem (spec 008 §3): é quem-é-quem, a verdade do gatilho
/// "primeiro contato" e a trava do "um chatbot por vez".
model WhatsappContact {
  id             String  @id @default(cuid())
  organizationId String
  jid            String
  number         String
  /// O nome que a pessoa pôs no próprio aparelho. Alimenta {{nome}}.
  pushName       String?

  /// A trava do um-por-vez. Coluna solta, sem FK para flow_execution, pelo
  /// mesmo motivo do automation -> flow_version da 006: fecharia um ciclo com
  /// o cascade. Única para que dois consumers em paralelo não criem duas
  /// execuções para o mesmo contato.
  activeExecutionId String? @unique

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  executions FlowExecution[]

  @@unique([organizationId, jid])
  @@map("whatsapp_contact")
}

/// Uma conversa do chatbot com um contato, presa à versão em que começou:
/// publicar outra versão no meio não muda o desenho que ela está seguindo.
model FlowExecution {
  id             String          @id @default(cuid())
  organizationId String
  contactId      String
  contact        WhatsappContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Ids soltos, sem FK: apagar uma automação não pode ser bloqueado pelo
  /// histórico dela, e o histórico não deve sumir junto.
  automationId  String
  flowVersionId String

  /// running | waiting | sleeping | completed | failed | expired
  status        String
  currentNodeId String?

  /// A trava otimista contra o at-least-once do BullMQ: sobe a cada passo, e um
  /// job com token velho é descartado em silêncio (spec 008 §4.6).
  waitToken Int @default(0)
  /// Orçamento total de blocos, contra fluxo cíclico. Sobrevive entre ticks —
  /// é o que faz o reagendamento do teto por tick não zerar o orçamento.
  stepCount Int @default(0)

  /// { "<variableId>": "<valor>" } — inclui sys:ultima_resposta, a única de
  /// sistema que é guardada (spec 008 §4.8).
  variables Json @default("{}")

  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @updatedAt
  /// Zumbi não segura contato para sempre: o job `expire` varre por aqui.
  expiresAt      DateTime
  finishedAt     DateTime?
  /// Só em failed/expired, para o log: "step-limit", "send-failed",
  /// "unimplemented-block:condition"…
  error          String?

  messages ExecutionMessage[]

  @@index([organizationId, status])
  @@index([contactId])
  @@index([status, expiresAt])
  @@map("flow_execution")
}

/// O que foi recebido e enviado NAQUELA execução, na ordem.
model ExecutionMessage {
  id          String        @id @default(cuid())
  executionId String
  execution   FlowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  /// in | out
  direction  String
  /// text | unsupported
  kind       String
  text       String?   @db.Text
  /// key.id do Baileys na entrada; o id devolvido pela Evolution na saída,
  /// quando ele existir (spec 008 §4.9).
  externalId String?
  /// Qual bloco produziu esta saída. Null na entrada.
  nodeId     String?
  /// Entrada: quando o motor a entregou a um `aguardar resposta`. Null = ainda
  /// no buffer. É esta coluna que É o buffer — sem segunda fonte da verdade.
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([executionId, externalId])
  @@index([executionId, createdAt])
  @@map("execution_message")
}
